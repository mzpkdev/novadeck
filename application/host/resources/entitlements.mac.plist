<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 compiles JavaScript at run time, which the hardened runtime forbids without it. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Voice input: the hardened runtime denies the microphone without it, before macOS
         asks with NSMicrophoneUsageDescription. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
