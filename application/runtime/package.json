{
  "name": "@novadeck/runtime",
  "version": "0.0.0",
  "private": true,
  "description": "The NovaDeck Hono backend.",
  "author": "mzpkdev",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./src/server.ts",
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
