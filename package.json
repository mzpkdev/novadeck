{
  "name": "novadeck",
  "version": "0.1.0",
  "private": true,
  "description": "A cross-platform desktop application.",
  "homepage": "https://github.com/mzpkdev/novadeck",
  "author": "mzpkdev",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "pnpm run build && electron-builder --dir --publish never",
    "package:linux": "pnpm run build && electron-builder --linux --x64 --publish never",
    "package:mac": "pnpm run build && electron-builder --mac --universal --publish never",
    "package:win": "pnpm run build && electron-builder --win --x64 --publish never",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.0",
    "msw": "^2.15.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@11.22.0",
  "desktopName": "dev.mzpk.novadeck",
  "productName": "NovaDeck"
}
