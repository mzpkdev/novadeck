{
  "name": "novadeck",
  "version": "0.0.0",
  "private": true,
  "description": "A cross-platform desktop application.",
  "homepage": "https://github.com/mzpkdev/novadeck",
  "author": "mzpkdev",
  "type": "module",
  "scripts": {
    "postinstall": "pnpm --dir design-system install --frozen-lockfile",
    "dev": "turbo run dev --filter=@novadeck/application",
    "storybook": "pnpm --filter @novadeck/design-system-workspace storybook",
    "build": "turbo run build",
    "preview": "pnpm --filter @novadeck/application preview",
    "package": "pnpm --filter @novadeck/application package",
    "package:linux": "pnpm --filter @novadeck/application package:linux",
    "package:mac": "pnpm --filter @novadeck/application package:mac",
    "package:win": "pnpm --filter @novadeck/application package:win",
    "test": "pnpm run test:repository && turbo run test",
    "test:repository": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "^26.6.2",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "msw": "^2.15.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "release-it": "21.1.0",
    "turbo": "^2.11.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@11.22.0"
}
